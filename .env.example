# Evelyn environment variables (API keys).
# Copy this file to ".env" in this folder and fill in YOUR OWN keys.
# This file is NOT private - only the real .env is.  Never share your .env.

# Fish Audio - voice synthesis. Get a key at https://fish.audio
FISH_API_KEY=your_fish_api_key_here

# Cerebras - the LLM "brain". Get a key at https://cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Optional logging controls (defaults shown).  Use DEBUG only while
# troubleshooting; INFO keeps the rotating log useful.
# EVELYN_LOG_LEVEL=INFO
# EVELYN_LOG_MAX_MB=5
# EVELYN_LOG_BACKUPS=3
